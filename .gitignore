# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
prisma/*.db
prisma/*.db-journal

# vercel
.vercel

# ingest output
ingest-summary.json

# typescript
*.tsbuildinfo
next-env.d.ts

# local tool / MCP configuration — machine-specific, never committed
# (the stitch server config lives outside the repo; these are per-machine
#  paths and registry wiring that should not ship)
/opencode.json
/opencode.jsonc
/mcp.json
/components.json
