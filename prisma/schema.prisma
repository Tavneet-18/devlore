generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id         String    @id @default(cuid())
  title      String
  summary    String?
  description String?
  date       DateTime
  endDate    DateTime?
  city       String?
  country    String    @default("India")
  isOnline   Boolean   @default(false)
  eventType  String
  organizer  String
  link       String?
  imageUrl   String?
  tags       String    @default("[]")
  beginnerFriendly Boolean @default(false)
  source     String    @default("manual")
  status     String    @default("APPROVED")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Ingest dedupe fields
  externalId String?   @unique
  hash       String?
  fetchedAt  DateTime  @default(now())
  rawPayload Json?
  expiresAt  DateTime?

  // Platform-stable identity. `externalId` above was set to the listing URL,
  // which several platforms rewrite — a changed slug therefore created a
  // duplicate row instead of updating the existing one. `sourceId` holds the
  // id the platform itself uses (slug or uuid) and is what we now upsert on.
  sourceId String?

  // WHICH date the countdown is measuring.
  //   "registration" -> the platform publishes a real registration deadline
  //   "event-end"    -> it does not, and we count down to the event's end date
  // NULL on manual submissions, which have no deadline of any kind.
  // Without this the UI would label a hackathon's finish date as
  // "Registration closes", which would be a small lie in a product built on
  // honest deadlines.
  deadlineKind String?

  bookmarks Bookmark[]
  sourceRefs EventSourceRef[]

  @@index([status])
  @@index([eventType])
  @@index([date])
  @@index([externalId])
  @@index([source, fetchedAt])
  @@index([hash])
  @@index([title])
  // Supports the "last checked" line on the detail page without a scan.
  @@index([fetchedAt])

  // Manual submissions have a NULL sourceId, and Postgres treats NULLs as
  // distinct in a unique index, so they must not collide with each other.
  @@unique([source, sourceId])

  // Migration 004. Note: `deadlineKind` "event-end" means the source has no
  // registration deadline, so the brief and the calendar button must both be
  // keyed on the real deadline, not this field.
  brief      String?
  whoCanJoin String?
  briefedAt  DateTime?
  details    Json?
}

/**
 * Every platform a single real event was seen on.
 *
 * The same hackathon is routinely listed on Devpost, Hack2Skill and a
 * corporate site at once. Without this, each sighting became its own Event row:
 * the count inflated, one real deadline looked like three urgent ones, and the
 * model was asked to summarise the same listing repeatedly.
 *
 * The first sighting stays on the Event row itself. Additional sightings land
 * here, so no platform's link is lost.
 */
model EventSourceRef {
  id          String   @id @default(cuid())
  eventId     String
  source      String
  sourceId    String
  link        String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([eventId])
}

/**
 * One row per source per ingest run.
 *
 * A silent ingest is indistinguishable from a working one. When a source
 * starts returning nothing — markup changed, endpoint moved, robots.txt
 * changed — there was previously no signal at all, because the cron only
 * reported what it wrote and never what it failed to fetch.
 */
model IngestRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  source      String
  fetched     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  errors      Int       @default(0)
  errorSample String?

  @@index([startedAt])
  @@index([source, startedAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  eventId   String
  viewerId  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([viewerId, eventId])
  @@index([viewerId])
}

// The view counter and this table were dropped in
// 20261004010000_drop_view_counter.
//
// A view was only attributable to a browser holding a `devlore_visitor` cookie,
// and only the bookmark route handlers set one, so a reader who never saved
// anything was never counted and the figure on every event page was a permanent
// 0. Counting every read would mean putting an identifier on every anonymous
// visitor, which is a privacy decision rather than a bug fix.
