generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id         String    @id @default(cuid())
  title      String
  summary    String?
  description String?
  date       DateTime
  endDate    DateTime?
  city       String?
  country    String    @default("India")
  isOnline   Boolean   @default(false)
  eventType  String
  organizer  String
  link       String?
  imageUrl   String?
  tags       String    @default("[]")
  beginnerFriendly Boolean @default(false)
  source     String    @default("manual")
  status     String    @default("APPROVED")
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Ingest dedupe fields
  externalId String?   @unique
  hash       String?
  fetchedAt  DateTime  @default(now())
  rawPayload Json?
  expiresAt  DateTime?

  // Platform-stable identity. `externalId` above was set to the listing URL,
  // which several platforms rewrite — a changed slug therefore created a
  // duplicate row instead of updating the existing one. `sourceId` holds the
  // id the platform itself uses (slug or uuid) and is what we now upsert on.
  sourceId String?

  // WHICH date the countdown is measuring.
  //   "registration" -> the platform publishes a real registration deadline
  //   "event-end"    -> it does not, and we count down to the event's end date
  // NULL on manual submissions, which have no deadline of any kind.
  // Without this the UI would label a hackathon's finish date as
  // "Registration closes", which would be a small lie in a product built on
  // honest deadlines.
  deadlineKind String?

  bookmarks Bookmark[]
  views     View[]

  @@index([status])
  @@index([eventType])
  @@index([date])
  @@index([externalId])
  @@index([source, fetchedAt])
  @@index([hash])
  @@index([title])

  // Partial: manual submissions have a NULL sourceId, and Postgres treats
  // NULLs as distinct, so they must not collide with each other.
  @@unique([source, sourceId])
}

/**
 * One row per source per ingest run.
 *
 * A silent ingest is indistinguishable from a working one. When a source
 * starts returning nothing — markup changed, endpoint moved, robots.txt
 * changed — there was previously no signal at all, because the cron only
 * reported what it wrote and never what it failed to fetch.
 */
model IngestRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  source      String
  fetched     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  errors      Int       @default(0)
  errorSample String?

  @@index([startedAt])
  @@index([source, startedAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  eventId   String
  viewerId  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([viewerId, eventId])
  @@index([viewerId])
}

model View {
  id        String   @id @default(cuid())
  eventId   String
  viewerId  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([viewerId])
  @@index([eventId])
}
