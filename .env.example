# ---------------------------------------------------------------------------
# Devlore — environment template
# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production. No value in this file is real.
#
# Anything marked REQUIRED must be set or the feature fails closed (it refuses
# to serve) rather than falling open.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ----------------------------------------------------
# Supabase Postgres. Use the POOLER host for DATABASE_URL (port 6543); the
# direct host is only needed for migrations and is not IPv6 reachable from
# every network.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<PASSWORD>@<POOLER_HOST>:5432/postgres"

# --- Development escape hatch ------------------------------------------------
# While the site is being built out, this steps around admin authentication and
# the detailed health report. The middleware, session signing and gating all
# stay in place; only this flag changes their behaviour.
#
#   AUTH_BYPASS=true   -> /admin, /api/admin/* and the detailed health report
#                         are open to anyone
#   anything else      -> authentication is enforced (fail-closed default)
#
# Because the default is fail-closed, forgetting to change it at launch turns
# security ON rather than leaving it off. The admin panel shows a warning
# banner while it is active.
#
# Rate limits, the submit honeypot, LLM output validation and the cron Bearer
# secret are NOT bypassed by this flag — they are not authentication, and they
# protect your Groq quota rather than the site's appearance.
#
# Remove this line entirely for a public launch.
AUTH_BYPASS=""

# --- Admin access (REQUIRED) -------------------------------------------------
# Single shared password for /admin. There is no recovery path other than
# resetting it here, so generate something long:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This value is also the HMAC key for the admin session cookie, so changing it
# signs every existing session out. With it unset, /admin and /api/admin/*
# return 503 and are unreachable.
ADMIN_PASSWORD=""

# --- Health endpoint (REQUIRED) ---------------------------------------------
# Grants access to the detailed /api/health report. Sent as a header:
#   curl -H "x-health-key: $HEALTH_KEY" https://<host>/api/health
# Without it, an admin session is still required — the public response is
# always just { "ok": boolean }.
HEALTH_KEY=""

# --- Cron protection (REQUIRED) ---------------------------------------------
# Vercel Cron automatically sends `Authorization: Bearer <CRON_SECRET>` when
# this variable exists on the project, so the scheduled ingest keeps working.
# Manual runs:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/ingest
# With it unset the endpoint is closed, not open.
CRON_SECRET=""

# --- AI enhancement ---------------------------------------------------------
# mock = deterministic keyword matcher, free, no network
# groq = Groq LLM (OpenAI-compatible). Get a key at https://console.groq.com
AI_PROVIDER="mock"
GROQ_API_KEY=""
# Optional. Defaults to llama-3.1-8b-instant.
GROQ_MODEL="llama-3.1-8b-instant"

# --- Discovery sources ------------------------------------------------------
# mock = bundled placeholder data, no network
# live = real events from the public source APIs (Devpost, Unstop, GDG, Devfolio)
DISCOVERY_MODE="mock"

# --- Rate limiting (optional but recommended in production) -----------------
# When both are set, rate limits are shared across all serverless instances.
# When absent, an in-process counter is used, which is per-instance only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Dormant / future -------------------------------------------------------
# Meetup's event search needs this for its GraphQL endpoint. The adapter
# returns nothing until it is set, so nothing unverified is ever ingested.
MEETUP_TOKEN=""
