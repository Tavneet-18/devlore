# ---------------------------------------------------------------------------
# Supabase Postgres
# ---------------------------------------------------------------------------
# Transaction pooling (port 6543) — used by the running app on Vercel.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by `prisma migrate` / build step.
DIRECT_URL="postgresql://postgres:<PASSWORD>@<DB_HOST>:5432/postgres"

# ---------------------------------------------------------------------------
# AI enhancement
# ---------------------------------------------------------------------------
# mock = keyword-based, free, no network
# groq = Groq LLM (OpenAI-compatible). Get a key at https://console.groq.com
AI_PROVIDER="mock"
GROQ_API_KEY=""

# ---------------------------------------------------------------------------
# Discovery sources
# ---------------------------------------------------------------------------
# mock = bundled placeholder data, no network
# live = real events from public source APIs (Devpost, Unstop, GDG)
# Meetup is disabled until a MEETUP_TOKEN is added.
DISCOVERY_MODE="mock"

# ---------------------------------------------------------------------------
# Cron protection
# ---------------------------------------------------------------------------
# Guards /api/cron/ingest. Vercel Cron sends the request without a header,
# so this is also accepted as ?secret=<value>.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
